---
---

<section id="contact" class="border-b border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 py-20 sm:py-28">
    <div class="text-[var(--color-accent-dim)] text-xs tracking-wider uppercase mb-3">
      // 04 - contact
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold mb-8 text-[var(--color-fg)]">
      engage
    </h2>

    <div class="border border-[var(--color-border)] bg-[var(--color-bg-elev)] p-6 sm:p-10 max-w-3xl">
      <pre class="text-xs sm:text-sm text-[var(--color-fg-dim)] mb-6 leading-relaxed overflow-x-auto">
<span class="text-[var(--color-accent)]">$</span> cat ./contact.txt
---
short, signal-rich messages preferred.
include a brief description of your objective, environment scope,
engagement type, and any relevant timing constraints.
we read everything. we reply to what fits.
---</pre>

      <a
        href="mailto:contact@radamic.com"
        class="inline-block border border-[var(--color-accent)] text-[var(--color-accent)] px-6 py-3 hover:bg-[var(--color-accent)] hover:text-[var(--color-fg)] transition text-sm"
      >
        contact@radamic.com
      </a>

      <div class="mt-8 pt-6 border-t border-[var(--color-border)] text-xs text-[var(--color-fg-dim)] space-y-1">
        <div><span class="text-[var(--color-accent-dim)]">PGP:</span> available on request</div>
        <div><span class="text-[var(--color-accent-dim)]">scope:</span> select engagements only</div>
        <div><span class="text-[var(--color-accent-dim)]">NDA:</span> standard, signed prior to scoping call</div>
      </div>
    </div>
  </div>
</section>
