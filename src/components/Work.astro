---
const work = [
  {
    tag: "case study - anonymized",
    title: "full-scope red team, regulated financial-sector target",
    body: "objective: prove whether a determined adversary could reach and exfiltrate crown-jewel data. outcome: domain compromise inside the first week via a chained misconfiguration and a custom loader; simulated exfiltration held long enough to demonstrate the monitoring gap; a follow-on purple phase measurably lifted the client's ATT&CK detection coverage. timeline, scope, and metrics shared under NDA.",
    stack: ["initial access", "active directory", "purple"],
  },
  {
    tag: "engagement type",
    title: "objective-driven red team",
    body: "scoped to a real outcome - data exfiltration, domain compromise, ransomware simulation, or detection validation. measured against your blue team, not a generic baseline.",
    stack: ["adversary emulation", "stealth ops", "purple"],
  },
  {
    tag: "engagement type",
    title: "exploit research & 0-day discovery",
    body: "targeted research against agreed-upon software stacks. we hunt for the class of bug that materially changes risk, then we weaponise it responsibly.",
    stack: ["fuzzing", "binary analysis", "PoC"],
  },
  {
    tag: "internal capability",
    title: "custom C2 & implant tooling",
    body: "modular C2 with encrypted channels and in-memory evasion patterns. operator-grade: minimal footprint, predictable behavior, easy to reason about under pressure.",
    stack: ["go", ".net", "evasion"],
  },
  {
    tag: "internal capability",
    title: "automated red team infrastructure",
    body: "ansible-driven deployment of redirectors, listeners, and labs. opsec-aware from the first commit. the unglamorous plumbing that lets the interesting work happen.",
    stack: ["ansible", "terraform", "linux"],
  },
];
---

<section id="work" class="border-b border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 py-20 sm:py-28">
    <div class="text-[var(--color-accent)] text-xs tracking-wider uppercase mb-3">
      // 03 - selected work
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold mb-3 text-[var(--color-fg)]">
      a sample of what's on the bench
    </h2>
    <p class="text-[var(--color-fg-dim)] mb-12 max-w-2xl">
      summarised. the actual code, methodology, and sample output stay
      private - reach out for a walkthrough.
    </p>

    <div class="space-y-px">
      {work.map((w, i) => (
        <article class="border border-[var(--color-border)] bg-[var(--color-bg-elev)] p-6 sm:p-8 hover:border-[var(--color-accent-dim)] transition group">
          <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
            <span class="text-[var(--color-bg)] bg-[var(--color-accent)] px-2 py-0.5 font-medium">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="text-[var(--color-fg-dim)] uppercase tracking-wider">{w.tag}</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-[var(--color-fg)] mb-3 group-hover:text-[var(--color-accent)] transition">
            {w.title}
          </h3>
          <p class="text-[var(--color-fg-dim)] leading-relaxed mb-5 max-w-3xl">
            {w.body}
          </p>
          <div class="flex flex-wrap gap-2 text-xs">
            {w.stack.map((s) => (
              <span class="border border-[var(--color-border)] text-[var(--color-fg-dim)] px-2 py-1">
                {s}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
