---
import banner from "./radamic.txt?raw";
---

<section id="top" class="relative grid-bg border-b border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 py-24 sm:py-36">
    <div class="text-[var(--color-fg-dim)] text-xs sm:text-sm mb-6 tracking-wider uppercase">
      // elite red team operations &amp; exploit development
    </div>

    <pre class="ascii text-[var(--color-accent)] text-[0.6rem] sm:text-xs leading-none overflow-x-auto select-none mb-8" aria-hidden="true">{banner}</pre>

    <h1 class="text-3xl sm:text-5xl font-bold mb-4 leading-tight">
      <span class="text-[var(--color-fg)]">redefining offensive security.</span><br />
      <span class="text-[var(--color-accent)] cursor">delivering elite outcomes.</span>
    </h1>

    <p class="text-[var(--color-fg-dim)] max-w-2xl text-base sm:text-lg leading-relaxed mb-10">
      radamic is a specialised offensive security outfit. we run end-to-end
      red team engagements, build the tooling and infrastructure that backs
      them, and conduct deep exploit research for clients who need more than
      a checklist pentest.
    </p>

    <div class="flex flex-wrap gap-4 text-sm">
      <a
        href="#capabilities"
        class="border border-[var(--color-accent)] text-[var(--color-accent)] px-5 py-2.5 hover:bg-[var(--color-accent)] hover:text-[var(--color-bg)] transition"
      >
        $ ls capabilities/
      </a>
      <a
        href="#contact"
        class="border border-[var(--color-border)] text-[var(--color-fg-dim)] px-5 py-2.5 hover:border-[var(--color-fg)] hover:text-[var(--color-fg)] transition"
      >
        $ engage
      </a>
    </div>
  </div>
</section>
