---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "radamic // elite red team operations",
  description = "radamic delivers elite red team operations, adversary emulation, exploit development, and offensive security research.",
} = Astro.props;

const site = Astro.site ?? new URL("https://radamic.com");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "radamic",
  url: site.href,
  email: "contact@radamic.com",
  description,
  areaServed: "Worldwide",
  serviceType: [
    "Red team operations",
    "Adversary emulation",
    "Penetration testing",
    "Exploit development",
    "Security research",
  ],
  knowsAbout: [
    "Offensive security",
    "Adversary emulation",
    "Exploit development",
    "Command and control",
    "Detection engineering",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="radamic" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="radamic" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="radamic - elite red team operations" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#191c23" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(orgSchema)}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">skip to content</a>
    <slot />
  </body>
</html>
